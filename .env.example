# Prefer Supabase connection pooler (port 6543) for Vercel serverless:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Local only: create tables + seed admin on startup (omit on Vercel)
FLASK_ENV=development
# Or force schema create without FLASK_ENV: ENABLE_DB_CREATE=1
